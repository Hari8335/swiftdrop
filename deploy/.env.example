# PostgreSQL Configuration
POSTGRES_USER=swiftdrop
POSTGRES_PASSWORD=swiftdrop_password
POSTGRES_PORT=5434
FRONTEND_PORT=4200

# Optional private OSRM routing proxy target. Leave blank until approved and activated.
SWIFTDROP_ROUTING_OSRM_URL=
SWIFTDROP_ROUTING_TIMEOUT_MS=10000
SWIFTDROP_ROUTING_MINIMUM_INTERVAL_MS=15000

# Email delivery
# Leave the defaults for local Mailpit, or set these for Gmail SMTP.
# Gmail requires an App Password; never commit the real password.
SPRING_MAIL_HOST=mailpit
SPRING_MAIL_PORT=1025
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
SPRING_MAIL_PROPERTIES_MAIL_SMTP_AUTH=false
SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=false
SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_REQUIRED=false
MANAGEMENT_HEALTH_MAIL_ENABLED=false

# External Integrations
LLM_API_KEY=placeholder-llm-api-key
# Fill these from a Google Cloud OAuth 2.0 Web application client.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Docker Compose gateway callback. For `ng serve` + direct auth-service, use port 8081.
GOOGLE_REDIRECT_URI=http://localhost:8080/api/v1/auth/oauth2/callback/google
GOOGLE_FRONTEND_CALLBACK_URL=http://localhost:4200/auth/callback
